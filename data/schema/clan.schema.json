{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vargdropi/clan.schema.json",
  "title": "VARGDROPI clan",
  "description": "One of the five clans (C-CLAN-01/02). Trust math and event design rationale live in docs/design/spec-clans-trust.md; this file is the data record.",
  "type": "object",
  "required": ["id", "name", "totem", "region", "identity", "custodian_jobs", "trust", "faith_path", "fire_path"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "description": "Machine id, e.g. 'ulfheim'." },
    "name": { "type": "string", "minLength": 1, "description": "Display name — placeholder until CANON's Rename Table clears it." },
    "totem": { "type": "string", "enum": ["wolf", "raven", "bear", "whale", "stag"] },
    "region": { "type": "string", "minLength": 1, "description": "Where in the Northlands they hold ground." },
    "identity": { "type": "string", "minLength": 1, "description": "One-paragraph identity per CANON §1.6." },
    "leader": {
      "type": "object",
      "description": "Placeholder character ref until Phase 1 names them (CANON Rename Table).",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1, "description": "Rename Table row, e.g. 'Ulfheim leader'." },
        "name": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "custodian_jobs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
      "description": "Job ids this clan is custodian of. Cross-checked against data/jobs/ once populated."
    },
    "trust": {
      "type": "object",
      "required": ["initial", "exercise_thresholds", "betrayal_threshold"],
      "additionalProperties": false,
      "properties": {
        "initial": { "type": "integer", "minimum": -100, "maximum": 100, "description": "TUNABLE. Starting trust at first contact." },
        "exercise_thresholds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": -100, "maximum": 100 },
          "description": "TUNABLE anchors [25,50,75] per C-CLAN-02: trust levels that unlock exercises 1–3."
        },
        "betrayal_threshold": { "type": "integer", "minimum": -100, "maximum": 0, "description": "TUNABLE anchor −25: below this, betrayal events may fire." },
        "sung_ledger_gate": { "type": "string", "description": "How the Sung Ledger modifies this clan's trust gains (C-ALIGN-02)." }
      }
    },
    "trust_exercises": {
      "type": "array",
      "description": "Authored in Phase 4 alongside spec-clans-trust; each unlocks at the matching threshold.",
      "items": {
        "type": "object",
        "required": ["id", "unlocks_at", "brief"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "unlocks_at": { "type": "integer", "minimum": -100, "maximum": 100 },
          "brief": { "type": "string", "minLength": 1 },
          "battle_ref": { "type": "string", "description": "Map id if the exercise is a battle." },
          "flags_set": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
        }
      }
    },
    "betrayal_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "condition", "brief"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "condition": { "type": "string", "minLength": 1 },
          "brief": { "type": "string", "minLength": 1 },
          "battle_ref": { "type": "string" },
          "flags_set": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
        }
      }
    },
    "faith_path": {
      "type": "object",
      "required": ["summary", "grants"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "grants": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Full job line + any extras (e.g. Hvalfjorð gear brokerage)." },
        "flags_set": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "fire_path": {
      "type": "object",
      "required": ["summary", "loots"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "loots": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Diminished variants looted (see job.schema.json diminished_variant)." },
        "flags_set": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    },
    "designer_notes": { "type": "string" }
  }
}
