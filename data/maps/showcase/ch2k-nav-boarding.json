  "objectives": {
    "primary": "Take the Landless captain (e1): down him or force his yield.",
    "secondary": [
      "No player unit lost to the sea.",
      "At least one oarsman (n1/n2) escapes — keep the boarding Sung as mercy or terror by choice, not by accident."
    ],
    "defeat": "Grím falls, or every player unit is pitched into the sea."
  },
  "escape_edges": [
    "E",
    "W"
  ],
  "witness_rule": "sung_if_any_witness_or_router_escapes",
  "triggers": [
    {
      "when": "turn>=1",
      "event": "grapples_set",
      "note": "The hulls are lashed; the three planks drop. The gap is crossable only on plank tiles from here."
    },
    {
      "when": "unit_off_zone:e2:plank",
      "event": "bridge_runner_committed",
      "once": true,
      "note": "Once the bridge-runner is on a plank, felling him there drops him to the sea (removal), not the deck."
    },
    {
      "when": "hp_below:e1:25",
      "event": "captain_yield_offer",
      "set_flag": "hvalfjord_fate",
      "once": true,
      "note": "The captain may cry grið at the gunwale; how it is answered before the oarsmen sets the market’s read and nudges hvalfjord_fate (bought if mercy keeps the account; burned only if the wharf-arc is later taken by fire). Enum write owned by scene:ch2k-s02."
    },
    {
      "when": "unit_downed:any_player",
      "event": "sea_takes_the_fallen",
      "note": "A player unit downed on a drown_edge tile is taken by the sea outright — grave-goods lost to the deep, no raven-count (a harsher C-DEATH-01 variant flagged for spec-combat-core)."
    }
  ],
  "designer_notes": {
    "height_gimmick": "The vertical axis is the GAP between two hulls, not a summit: the sea (cols 7-8, elevation 0) between the decks is the only low ground and it is instant removal, so the three plank bridges (rows 3/6/9) are the sole crossings and knockback over any gunwale into the drown_edge water_deep deletes a unit outright rather than damaging it — cut a bridge and you strand half a boarding party. Distinct from every ch1 summit map and the other showcases.",
    "witness_setup": "Hvalfjord oarsmen crouch beneath the fighting lines on both keels and survive to carry the tale to every port on the whale-road; the recording skald watches from the king’s stem-castle. Cut the planks and pitch a whole crew to the sea and the action can vanish Unsung — but a drowned man does not surface where doctrine promised, and the oarsmen who live (n1 flees E, n2 flees W) will say so (harvest-lie suspicion).",
    "intent": "Naval set-piece and the Hvalfjord faith/fire fork made physical (bought vs burned); the first fight with no elevation crutch, where removal-by-sea replaces the kill verb and the player chooses how much the market sees."
